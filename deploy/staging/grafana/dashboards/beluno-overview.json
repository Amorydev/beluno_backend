{
  "uid": "beluno-overview",
  "title": "Beluno overview",
  "tags": [
    "beluno"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count[5m]))",
          "legendFormat": "{{http_status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "API requests per second by status code (health probes are not instrumented).",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "5xx ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[10m])) / sum(rate(http_server_duration_milliseconds_count[10m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Alert threshold: 0.5% for 10 minutes.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Command p95 by name",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, command) (rate(beluno_command_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{command}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{http_method=\"POST\", http_target=\"/v1/sync/pull\"}[5m])))",
          "legendFormat": "sync pull (HTTP)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "description": "Targets: expense.create 300 ms, settlement.record 300 ms, sync pull 1 s. Histogram buckets are coarse near 300 ms.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Ledger lock wait p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(beluno_finance_ledger_lock_wait_milliseconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "description": "Alert threshold: 1 s for 10 minutes.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Ledger drift findings",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "sum(beluno_finance_ledger_drift_total) or vector(0)",
          "legendFormat": "findings",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Reconciliation findings counted since the worker started. Any value above zero is an incident.",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Job queue oldest waiting age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "max(beluno_jobs_queue{measure=\"oldest_waiting_seconds\"})",
          "legendFormat": "oldest waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Alert threshold: 300 s. Refreshed by the worker every five minutes.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Job queue depth by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "max by (measure) (beluno_jobs_queue{measure=~\"todo|doing|failed\"})",
          "legendFormat": "{{measure}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "failed is the dead-letter queue.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Sync push results",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "sum by (outcome) (rate(beluno_sync_push_results_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Push operation results per second by outcome.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Sync pull pages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "beluno-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "beluno-prometheus"
          },
          "expr": "sum by (scope_type, status) (rate(beluno_sync_pull_pages_total[5m]))",
          "legendFormat": "{{scope_type}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Pull pages per second; a rise in resync_required means clients are rebuilding their state.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
