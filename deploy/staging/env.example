# Copy to deploy/staging/.env and replace every CHANGE_ME. The .env file is
# git-ignored; never commit real values. Every value below is a placeholder.
#
# Database passwords end up inside connection URLs: use URL-safe characters only, e.g.
#   openssl rand -hex 24

# --- PostgreSQL (roles are created on the first start of an empty data volume) ---
POSTGRES_DB=beluno
POSTGRES_PASSWORD=CHANGE_ME
BELUNO_MIGRATOR_DB_PASSWORD=CHANGE_ME
BELUNO_API_DB_PASSWORD=CHANGE_ME
BELUNO_WORKER_DB_PASSWORD=CHANGE_ME
BELUNO_SCHEDULER_DB_PASSWORD=CHANGE_ME

# --- Identity ---
# Generate both values from the repository root and paste the output here:
#   uv run python scripts/generate_signing_key.py --with-token-hash-key
# Keep the single quotes: the signing keys are a JSON document. The placeholders
# below are deliberately invalid, so the API refuses to start until they are replaced.
BELUNO_AUTH_SIGNING_KEYS='[{"kid":"CHANGE_ME","private_key_pem":"CHANGE_ME"}]'
BELUNO_TOKEN_HASH_KEY='CHANGE_ME'
# Keyring for booking codes and private notes at rest (API only); add --with-booking-keys
# to the command above. Rotate by adding a key and making it active; keep old keys.
BELUNO_BOOKING_KEYS='CHANGE_ME'
BELUNO_AUTH_ISSUER=beluno
BELUNO_AUTH_AUDIENCE=beluno-api
BELUNO_AUTH_GOOGLE_CLIENT_IDS=[]
BELUNO_AUTH_APPLE_CLIENT_IDS=[]
# BELUNO_AUTH_MAGIC_LINK_URL=https://app.example.invalid/auth/email
# Passkeys (API only): the app's domain, and a JSON list of https:// web origins and
# android:apk-key-hash: origins of the signed app.
BELUNO_WEBAUTHN_RP_ID=app.example.invalid
BELUNO_WEBAUTHN_ORIGINS='["https://app.example.invalid"]'

# --- Runtime ---
# "development" is accepted by the bundled plain-text PostgreSQL and collector.
# "staging" or "production" additionally require, in each Beluno process: its own
# BELUNO_*_DATABASE_URL (compose sets BELUNO_PROCESS_ROLE per service) with
# sslmode=require or stricter, BELUNO_EMAIL_BACKEND=smtp with a host and sender, and
# an https BELUNO_OTEL_EXPORTER_OTLP_ENDPOINT.
BELUNO_ENVIRONMENT=development
BELUNO_LOG_LEVEL=INFO
BELUNO_RELEASE=staging
# Image to run; the default is built locally from the Dockerfile.
# BELUNO_IMAGE=registry.example.invalid/beluno-backend:CHANGE_ME
# BELUNO_SENTRY_DSN=

# --- Network ---
# Interface the API port binds to on the host.
BELUNO_PUBLISH_ADDRESS=127.0.0.1
BELUNO_API_PORT=8000
# Interface Grafana, Prometheus, and Alertmanager bind to. Prometheus and Alertmanager
# have no authentication (anyone reaching Alertmanager can silence alerts): keep this
# on loopback and use an SSH tunnel or an authenticating proxy.
BELUNO_MONITORING_PUBLISH_ADDRESS=127.0.0.1
# Reverse proxy address(es) or CIDRs trusted for X-Forwarded-For. Never "*". A proxy on
# the host reaches the container through Docker's bridge, so its address is usually the
# bridge gateway (for example 172.17.0.1), not 127.0.0.1: check with a request and set it.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Email (console prints sign-in codes to the API/worker log) ---
BELUNO_EMAIL_BACKEND=console
# BELUNO_EMAIL_FROM=Beluno <no-reply@example.invalid>
# BELUNO_SMTP_HOST=
# BELUNO_SMTP_PORT=587
# BELUNO_SMTP_USERNAME=
# BELUNO_SMTP_PASSWORD=
# BELUNO_SMTP_SECURITY=starttls

# --- Kill switches (reads and recovery stay available; recreate api and worker after changing) ---
BELUNO_INVITES_ENABLED=true
BELUNO_GUEST_ACCESS_ENABLED=true
BELUNO_PARTICIPANT_CLAIMS_ENABLED=true
BELUNO_FINANCE_WRITES_ENABLED=true
BELUNO_SYNC_PUSH_ENABLED=true
BELUNO_SYNC_PULL_ENABLED=true
# Command names refused on REST and push alike, for example ["plan.duplicate"].
BELUNO_SYNC_DISABLED_COMMANDS=[]

# --- Sync kernel (retention must be at least the offline window) ---
BELUNO_SYNC_OFFLINE_WINDOW_DAYS=90
BELUNO_SYNC_CHANGE_RETENTION_DAYS=180
BELUNO_SYNC_OPERATION_RETENTION_DAYS=180
BELUNO_SYNC_PUSH_MAX_OPERATIONS=100
BELUNO_SYNC_PUSH_MAX_BYTES=1048576
BELUNO_SYNC_PULL_PAGE_SIZE=200

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
