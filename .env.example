BELUNO_ENVIRONMENT=development
BELUNO_LOG_LEVEL=INFO
BELUNO_RELEASE=dev
BELUNO_API_DATABASE_URL=postgresql+psycopg://api_runtime:api_password@localhost:54329/beluno_test
BELUNO_WORKER_DATABASE_URL=postgresql+psycopg://worker_runtime:worker_password@localhost:54329/beluno_test
BELUNO_SCHEDULER_DATABASE_URL=postgresql+psycopg://scheduler_runtime:scheduler_password@localhost:54329/beluno_test
BELUNO_MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:migrator_password@localhost:54329/beluno_test

# Identity (ADR 0007). Generate local values with:
#   uv run python scripts/generate_signing_key.py --with-token-hash-key
# BELUNO_AUTH_SIGNING_KEYS='[{"kid":"...","private_key_pem":"-----BEGIN PRIVATE KEY-----\n..."}]'
# BELUNO_TOKEN_HASH_KEY=
BELUNO_AUTH_ISSUER=beluno
BELUNO_AUTH_AUDIENCE=beluno-api
BELUNO_AUTH_GOOGLE_CLIENT_IDS=[]
BELUNO_AUTH_APPLE_CLIENT_IDS=[]
# BELUNO_AUTH_MAGIC_LINK_URL=https://app.example.com/auth/email

# Email: console prints codes locally; staging/production require smtp with TLS.
BELUNO_EMAIL_BACKEND=console
# BELUNO_EMAIL_FROM=Beluno <no-reply@example.com>
# BELUNO_SMTP_HOST=
# BELUNO_SMTP_PORT=587
# BELUNO_SMTP_USERNAME=
# BELUNO_SMTP_PASSWORD=
# BELUNO_SMTP_SECURITY=starttls

# Kill switches for new entrypoints (reads and recovery stay available).
BELUNO_INVITES_ENABLED=true
BELUNO_GUEST_ACCESS_ENABLED=true
BELUNO_PARTICIPANT_CLAIMS_ENABLED=true

BELUNO_SENTRY_DSN=
BELUNO_OTEL_EXPORTER_OTLP_ENDPOINT=
